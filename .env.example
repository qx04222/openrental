# ─── Required ────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://postgres:password@localhost:5432/openrental

NODE_ENV=development
PORT=3000
SITE_URL=http://localhost:3000
VITE_APP_URL=http://localhost:3000

# ─── Locale ──────────────────────────────────────────────────────────────────
# The yard's timezone. Every calendar date — rental days, due dates, invoice
# periods — is anchored here, so it must match reality or invoices land on the
# wrong day. Any IANA zone; an invalid value fails at boot rather than silently
# shifting dates. Keep VITE_APP_TIMEZONE identical so the UI agrees, and
# CRON_TIMEZONE identical so nightly jobs fire at local 09:00, not UTC 09:00.
APP_TIMEZONE=America/Toronto
VITE_APP_TIMEZONE=America/Toronto
CRON_TIMEZONE=America/Toronto

# ─── Optional integrations ───────────────────────────────────────────────────
# Everything below is off when unset, and stays visibly off — an unconfigured
# integration reports "skipped", never a silent success. None of it is needed to
# run, seed, test or evaluate OpenRental.
#
# NOTE: business email and SMS (invoice delivery, rental reminders) are
# configured in the admin UI under Settings → Notifications, which stores the
# provider credentials in the database — not here. The two SMS variables below
# are only for login one-time codes, which deliberately bypass the notification
# toggles so that turning notifications off cannot lock anyone out.

# Object storage for inspection photos and generated PDFs (Supabase Storage).
SUPABASE_URL=
SUPABASE_SERVICE_KEY=

# Login one-time codes over SMS (Telnyx). Without these, OTP login is disabled.
TELNYX_API_KEY=
TELNYX_PHONE_NUMBER=

# Card payment (Stripe) — only for the customer self-serve checkout.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_DEPOSIT_CAPTURE_METHOD=manual

# Google Analytics 4, customer-facing pages only. Unset means gtag never loads.
VITE_GA4_ID=

# Delivery distance lookup for distance-banded shipping prices.
GOOGLE_MAPS_API_KEY=
VITE_GOOGLE_MAPS_API_KEY=

# ─── Tuning ──────────────────────────────────────────────────────────────────
# Rate limits, per window. Defaults are sane; raise only if you know why.
# TRPC_RATE_MAX=
# RENTAL_CREATE_RATE_MAX=
# VERIFY_SESSION_RATE_MAX=
